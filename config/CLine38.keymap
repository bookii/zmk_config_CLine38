#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime_macro.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        en {
            bindings = <&kp LANGUAGE_2>;
            key-positions = <12 13>;
        };

        ja {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <17 16>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
        };

        screenshot {
            bindings = <&kp LS(LG(NUMBER_4))>;
            key-positions = <11 12 13 10>;
        };
    };

    behaviors {
        lt_mkp: lt_mkp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&mkp>;

            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&trans            &kp Z               &kp U           &kp F  &kp COMMA                            &kp G         &kp W  &kp R            &kp Y                &trans
&mt LEFT_SHIFT E  &mt LEFT_CONTROL I  &mt LEFT_ALT A  &kp O  &kp MINUS                            &kp K         &kp T  &mt RIGHT_ALT N  &mt RIGHT_CONTROL S  &mt LEFT_SHIFT H
&mt LEFT_GUI L    &kp X               &kp C           &kp V  &trans                               &trans        &kp D  &kp M            &lt 6 J              &lt 5 B
                  &trans              &trans          &kp Q  &lt 1 SPACE  &kp BACKSPACE    &kp P  &lt 2 RETURN                          &mo 4
            >;
        };

        punctuation {
            bindings = <
&trans            &kp LS(NUMBER_2)   &kp LS(NUMBER_1)  &kp LS(SLASH)  &kp PERIOD                       &trans   &kp LS(LEFT_BRACKET)  &kp LS(SQT)     &kp LS(RIGHT_BRACKET)  &trans
&kp LS(NUMBER_3)  &kp LS(BACKSLASH)  &kp GRAVE         &kp SLASH      &kp LS(MINUS)                    &trans   &kp LS(NUMBER_9)      &kp LS(SEMI)    &kp LS(NUMBER_0)       &kp SEMICOLON
&kp LS(NUMBER_4)  &kp LS(GRAVE)      &kp LS(NUMBER_6)  &kp LS(N7)     &trans                           &trans   &kp LEFT_BRACKET      &kp APOSTROPHE  &kp RIGHT_BRACKET      &kp LS(BACKSLASH)
                  &trans             &trans            &trans         &trans         &trans    &trans  &kp TAB                                        &trans
            >;
        };

        number {
            bindings = <
&trans         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD                     &kp COMMA         &kp LS(COMMA)   &kp UP_ARROW    &kp LS(PERIOD)   &trans
&kp LS(EQUAL)  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS                      &kp LS(NUMBER_8)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp SLASH
&kp NUMBER_0   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans                         &trans            &trans          &trans          &mo 3            &kp EQUAL
               &trans        &trans        &trans        &kp LS(TAB)  &trans    &trans  &trans                                            &trans
            >;
        };

        function {
            bindings = <
&trans   &kp F1  &kp F2  &kp F3  &kp F11                    &trans  &trans  &trans  &trans  &trans
&trans   &kp F4  &kp F5  &kp F6  &kp F12                    &trans  &trans  &trans  &trans  &trans
&kp F10  &kp F7  &kp F8  &kp F9  &trans                     &trans  &trans  &trans  &trans  &trans
         &trans  &trans  &trans  &trans   &trans    &trans  &trans                  &trans
            >;
        };

        bluetooth {
            bindings = <
&bt BT_CLR_ALL  &bt BT_CLR    &trans        &trans        &trans                                  &trans  &trans  &trans  &trans  &trans
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                            &trans  &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans                                  &trans  &trans  &trans  &trans  &trans
                &trans        &trans        &trans        &trans        &trans    &studio_unlock  &trans                  &trans
            >;
        };

        mouse {
            bindings = <
&trans     &trans  &trans  &trans  &trans                    &trans  &trans     &trans     &trans     &trans
&kp LG(E)  &trans  &trans  &trans  &trans                    &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans
&kp LG(L)  &trans  &trans  &trans  &trans                    &trans  &trans     &trans     &trans     &trans
           &trans  &trans  &trans  &trans  &trans    &trans  &trans                        &trans
            >;
        };

        scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans    &trans  &trans                  &trans
            >;
        };
    };
};
