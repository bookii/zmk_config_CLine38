#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime_macro.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        middle_click {
            bindings = <&mkp MCLK>;
            key-positions = <32 12>;
        };

        right_click {
            bindings = <&mkp RCLK>;
            key-positions = <32 13>;
        };

        en {
            bindings = <&kp LANGUAGE_2>;
            key-positions = <12 13>;
        };

        ja {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <17 16>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <1 3>;
        };

        screenshot {
            bindings = <&kp LS(LG(NUMBER_4))>;
            key-positions = <8 6>;
        };
    };

    behaviors {
        lt_mkp: lt_mkp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&mkp>;

            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&trans            &kp Z               &kp U           &kp F           &kp COMMA                                                       &kp G         &kp W    &kp R            &kp Y                &trans
&mt LEFT_SHIFT E  &mt LEFT_CONTROL I  &mt LEFT_ALT A  &lt 6 O         &kp MINUS                                                       &kp K         &lt 6 T  &mt RIGHT_ALT N  &mt RIGHT_CONTROL S  &mt RIGHT_SHIFT H
&kp L             &kp X               &kp C           &kp V           &kp Q                                                           &kp P         &kp D    &kp M            &kp J                &kp B
                  &trans              &trans          &lt_mkp 5 LCLK  &lt 1 SPACE  &mt LEFT_GUI BACKSPACE    &mt RIGHT_GUI BACKSPACE  &lt 2 RETURN                            &mo 4
            >;
        };

        punctuation {
            bindings = <
&trans            &kp LS(NUMBER_2)   &kp LS(NUMBER_1)  &kp LS(SLASH)  &kp PERIOD                       &trans   &kp LEFT_BRACKET      &kp LS(SQT)       &kp RIGHT_BRACKET      &trans
&kp LS(NUMBER_3)  &kp LS(BACKSLASH)  &kp GRAVE         &kp SLASH      &kp LS(MINUS)                    &trans   &kp LS(LEFT_BRACKET)  &kp SINGLE_QUOTE  &kp LS(RIGHT_BRACKET)  &kp SEMICOLON
&kp LS(NUMBER_4)  &kp LS(GRAVE)      &kp LS(NUMBER_6)  &kp BACKSLASH  &trans                           &trans   &kp LS(COMMA)         &trans            &kp LS(PERIOD)         &kp LS(NUMBER_7)
                  &trans             &trans            &trans         &trans         &trans    &trans  &kp TAB                                          &trans
            >;
        };

        number {
            bindings = <
&trans            &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD                     &kp COMMA  &kp LS(NUMBER_9)  &kp UP_ARROW    &kp LS(NUMBER_0)  &trans
&kp LS(EQUAL)     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS                      &kp EQUAL  &kp LEFT_ARROW    &kp DOWN_ARROW  &kp RIGHT_ARROW   &lt 3 LS(SEMICOLON)
&kp LS(NUMBER_8)  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp SLASH                      &trans     &trans            &trans          &trans            &trans
                  &trans        &trans        &kp NUMBER_0  &kp LS(TAB)  &trans    &trans  &trans                                       &trans
            >;
        };

        function {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F10                    &trans  &trans  &trans  &trans  &trans
&trans  &kp F4  &kp F5  &kp F6  &kp F11                    &trans  &trans  &trans  &trans  &trans
&trans  &kp F7  &kp F8  &kp F9  &kp F12                    &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans   &trans    &trans  &trans                  &trans
            >;
        };

        bluetooth {
            bindings = <
&bt BT_CLR_ALL  &bt BT_CLR    &trans        &trans        &trans                                  &trans  &trans  &trans  &trans  &trans
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                            &trans  &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans                                  &trans  &trans  &trans  &trans  &trans
                &trans        &trans        &trans        &trans        &trans    &studio_unlock  &trans                  &trans
            >;
        };

        scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans    &trans  &trans                  &trans
            >;
        };

        backspace {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                                  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &kp BACKSPACE    &kp BACKSPACE  &trans                  &trans
            >;
        };
    };
};
